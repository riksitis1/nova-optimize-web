@echo off
setlocal
title Nexa Optimize v1.4.0  Quick Setup
echo.
echo  ========================================================
echo   NEXA OPTIMIZE v1.4.0  SELF-EXTRACTING SETUP
echo   Proprietary Freeware · 100% Free Forever · All Rights Reserved
echo  ========================================================
echo.
set "INSTALL_DIR=%LOCALAPPDATA%\Programs\Nexa-Optimize"

echo  [1/4] Checking Node.js environment...
where node >nul 2>nul
if errorlevel 1 (
  if exist "%ProgramFiles%\nodejs\node.exe" set "PATH=%ProgramFiles%\nodejs;%PATH%"
  if exist "%LOCALAPPDATA%\Programs\nodejs\node.exe" set "PATH=%LOCALAPPDATA%\Programs\nodejs;%PATH%"
)
where node >nul 2>nul
if errorlevel 1 (
  where winget >nul 2>nul
  if not errorlevel 1 (
    echo        Node.js not detected. Auto-installing Node.js LTS via winget...
    winget install OpenJS.NodeJS.LTS --accept-package-agreements --accept-source-agreements --silent
    for /f "tokens=2*" %%A in ('reg query "HKLM\System\CurrentControlSet\Control\Session Manager\Environment" /v Path 2^>nul') do set "SYS_PATH=%%B"
    for /f "tokens=2*" %%A in ('reg query "HKCU\Environment" /v Path 2^>nul') do set "USR_PATH=%%B"
    set "PATH=%ProgramFiles%\nodejs;%LOCALAPPDATA%\Programs\nodejs;%SYS_PATH%;%USR_PATH%;%PATH%"
  )
)

echo  [2/4] Extracting hardened Nexa Optimize v1.4.0 to:
echo        %INSTALL_DIR%
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference = 'Stop'; $lines = Get-Content -LiteralPath '%~f0'; $idx = [Array]::IndexOf($lines, '::PAYLOAD_BEGIN::'); if ($idx -lt 0) { throw 'Payload marker not found' }; $b64 = ($lines[($idx + 1)..($lines.Length - 1)]) -join ''; $bytes = [Convert]::FromBase64String($b64); $tmpZip = Join-Path $env:TEMP ('Nexa-Optimize-Setup-' + [guid]::NewGuid().ToString('N') + '.zip'); [IO.File]::WriteAllBytes($tmpZip, $bytes); $dest = $env:INSTALL_DIR; if (!(Test-Path $dest)) { New-Item -ItemType Directory -Path $dest -Force | Out-Null }; Expand-Archive -LiteralPath $tmpZip -DestinationPath $dest -Force; Remove-Item -LiteralPath $tmpZip -Force"
if %ERRORLEVEL% NEQ 0 (
  echo  [ERROR] Extraction failed.
  pause
  exit /b 1
)
echo  [3/4] Creating NEXA Desktop and Start Menu shortcuts...
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%INSTALL_DIR%\Create Shortcut.ps1"
echo  [4/4] Launching Nexa Optimize...
cd /d "%INSTALL_DIR%"
call "%INSTALL_DIR%\Install Nexa.bat"
exit /b 0
