@echo off
setlocal
title Nova Optimize v1.0.0 - Web Setup
echo.
echo   ============================================================
echo     Nova Optimize v1.0.0 - Windows 10/11 Setup
echo     Provided "AS IS" without warranty under the MIT License.
echo   ============================================================
echo.
echo   Installing to: %LOCALAPPDATA%\Programs\Nova-Optimize
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $self='%~f0'; $lines=[System.IO.File]::ReadAllLines($self); $idx=[Array]::IndexOf($lines,'::PAYLOAD_BEGIN::'); if($idx -lt 0){throw 'Payload marker missing'}; $b64=($lines[($idx+1)..($lines.Length-1)]) -join ''; $bytes=[Convert]::FromBase64String($b64); $tmp=Join-Path $env:TEMP 'Nova-Optimize-Setup.zip'; [System.IO.File]::WriteAllBytes($tmp,$bytes); $dest=Join-Path $env:LOCALAPPDATA 'Programs'; if(-not (Test-Path $dest)){New-Item -ItemType Directory -Path $dest | Out-Null}; Expand-Archive -LiteralPath $tmp -DestinationPath $dest -Force; Remove-Item -LiteralPath $tmp -Force; $appDir=Join-Path $dest 'Nova-Optimize'; & (Join-Path $appDir 'Create Shortcut.ps1'); Write-Host '  [OK] Installed to' $appDir -ForegroundColor Green"
if errorlevel 1 (
  echo.
  echo   [!] Installation encountered an error.
  pause
  exit /b 1
)
echo.
set /p RUN_NOVA="  Start Nova Optimize now? [Y/N] (default Y): "
if "%RUN_NOVA%"=="" set RUN_NOVA=Y
if /i "%RUN_NOVA%"=="Y" (
  call "%LOCALAPPDATA%\Programs\Nova-Optimize\Start Nova.bat"
)
exit /b 0
