if "%RUN_NOVA%"=="" set RUN_NOVA=Y
if /i "%RUN_NOVA%"=="Y" (
  start "" wscript.exe "%LOCALAPPDATA%\Programs\Nova-Optimize\NovaOptimize.vbs"
)
exit /b 0
